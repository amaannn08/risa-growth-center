{
  "name": "growth-center",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "pnpm --filter @gc/db exec tsx scripts/cli.ts migrate",
    "db:seed": "pnpm --filter @gc/db exec tsx scripts/cli.ts seed",
    "db:verify": "pnpm --filter @gc/db exec tsx scripts/cli.ts verify",
    "db:reset": "pnpm --filter @gc/db exec tsx scripts/cli.ts reset"
  },
  "devDependencies": {
    "turbo": "^2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22"
  }
}