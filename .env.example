# Copy to apps/web/.env.local (git-ignored). Never commit real values.
DATABASE_URL=            # Neon pooled URL (postgres://…) — or pglite:./.pglite for a local embedded DB
DEEPSEEK_API_KEY=        # server-side only
DEEPSEEK_MODEL=deepseek-flash   # falls back to deepseek-chat on model errors
COPILOT_MODE=native      # native | json | mock (mock = scripted, used by e2e)
NEXT_PUBLIC_SITE_URL=    # shown in the slide footer, e.g. https://<project>.vercel.app
# Optional limits
# CHAT_RATE_LIMIT=20         # questions per 10 min per IP hash
# CHAT_DAILY_CAP=1500        # Copilot questions per rolling day (via chat_logs)
# MUTATION_RATE_LIMIT=30     # edits/resets per 10 min per IP
